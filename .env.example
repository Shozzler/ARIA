# UniFi Configuration
UNIFI_CONTROLLER_IP=your-controller-ip
# UNIFI_API_KEY is NOT stored here - it lives in the encrypted vault.
# Store it with:  .\set_secret.ps1 -Name UNIFI_API_KEY
UNIFI_SITE_ID=

# Example values (replace with your actual values):
# UNIFI_CONTROLLER_IP=10.20.40.1
# UNIFI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# UNIFI_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FLASK_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32

# LG webOS TV
TV_IP=your-tv-local-ip-eg-10.20.40.60
TV_MAC=your-tv-mac-eg-aa:bb:cc:dd:ee:ff

# Flask debug mode - only set to 1 on your own PC, never on the NAS
FLASK_DEBUG=0
