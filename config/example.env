# ARIA Configuration File
# Copy this file to .env and fill in your actual values

# Ubiquiti UniFi Settings
UNIFI_HOST=192.168.1.1
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your_password
UNIFI_SITE_ID=

# HomeConnect Settings
HOMECONNECT_CLIENT_ID=your_client_id
HOMECONNECT_CLIENT_SECRET=your_client_secret

# LG WebOS Settings
LG_TV_IP=192.168.1.50
LG_TV_MAC=00:00:00:00:00:00

# Server Settings
SERVER_PORT=5000
DEBUG=True
LOG_LEVEL=INFO
